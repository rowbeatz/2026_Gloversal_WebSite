# Gloversal Admin Panel — environment variables
# Copy this file to `.env` and fill in your real values.
# `.env` is gitignored and never committed.

# ── Admin login ──────────────────────────────────────────────────
# These are the credentials you will type at /admin/login.html
ADMIN_USER=
ADMIN_PASS=

# ── JWT signing secret ──────────────────────────────────────────
# Any 32+ char random string. Used to sign session tokens.
JWT_SECRET=change-me-to-a-random-32-char-string

# ── AI provider keys (optional) ─────────────────────────────────
# These are read on first launch and migrated into settings.json.
# After that, manage them from the Settings page in the admin UI.
# Leave any provider blank if you don't use it.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
MISTRAL_API_KEY=
GROQ_API_KEY=
TOGETHER_API_KEY=
PERPLEXITY_API_KEY=
COHERE_API_KEY=
DEEPSEEK_API_KEY=

# Default model the playground uses if no override is set
AI_MODEL=claude-sonnet-4-6
