# Cloudflare Pages / Netlify-compatible headers.
# HTML pages must revalidate on every request — avoids stale markup after
# content updates (e.g. an image swap that leaves edge caches referencing
# a now-404 asset).
/*
  Cache-Control: public, max-age=300, must-revalidate

/*.html
  Cache-Control: public, max-age=0, must-revalidate

# CSS / JS can be cached longer — we ship them rarely and filenames carry
# intent. If content changes we rename.
/css/*
  Cache-Control: public, max-age=86400, must-revalidate
/js/*
  Cache-Control: public, max-age=86400, must-revalidate

# Static binary assets (images, video, fonts) are keyed by filename, so
# aggressive caching is safe.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
