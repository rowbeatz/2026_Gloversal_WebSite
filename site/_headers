# Cloudflare Pages / Netlify-compatible headers.
# HTML pages must revalidate on every request — avoids stale markup after
# content updates (e.g. an image swap that leaves edge caches referencing
# a now-404 asset).
/*
  Cache-Control: public, max-age=300, must-revalidate

/*.html
  Cache-Control: public, max-age=0, must-revalidate

# CSS / JS: always revalidate so fixes roll out immediately. 304 responses
# are cheap; 24-hour stale JS during active development is not.
/css/*
  Cache-Control: public, no-cache, must-revalidate
/js/*
  Cache-Control: public, no-cache, must-revalidate

# Static binary assets (images, video, fonts) are keyed by filename, so
# aggressive caching is safe.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
